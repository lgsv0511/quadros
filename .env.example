# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA comite o arquivo ".env" (ele já está no .gitignore).

# Obrigatório — chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional — porta em que o servidor sobe (padrão: 3000)
PORT=3000

# Opcional — modelo usado para gerar os quadros (padrão: claude-sonnet-5)
# Troque para claude-opus-5 se quiser priorizar qualidade sobre custo/velocidade.
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional — teto de tokens de saída por geração (padrão: 8000)
ANTHROPIC_MAX_TOKENS=8000

# Opcional — limite de gerações por hora, por IP (padrão: 20)
# Importante: esta ferramenta fica pública e sem login, então cada
# geração custa uso real da sua API. Ajuste esse número conforme o
# volume que você espera e o quanto está disposto a gastar.
RATE_LIMIT_PER_HOUR=20
